{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gtrz-mail",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "mail.gtrz.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtrz-mail",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET",
      "bucket_name": "gtrz-mail-storage"
    }
  ],
  "vars": {
    "APP_NAME": "GTRZ Mail",
    "APP_ORIGIN": "https://mail.gtrz.com.br",
    "SESSION_DAYS": "7",
    "MAX_OUTBOUND_ATTACHMENT_BYTES": "18874368"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
